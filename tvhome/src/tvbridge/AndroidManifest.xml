<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback"
        android:required="true" tools:node="replace"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <application tools:replace="android:label" android:label="SatNova TV Home"
        android:banner="@drawable/satnova_tv_banner">
        <!-- Optional HDMI bridge edition: explicit Accessibility service and TV HOME. -->
        <activity android:name=".MobilePreviewActivity" tools:node="remove"/>
        <service android:name=".Zen4PersistentService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice"/>
        <service android:name=".Zen4HdmiRemoteService"
            android:label="SatNova · Télécommande Zen 4 sur HDMI"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data android:name="android.accessibilityservice"
                android:resource="@xml/zen4_hdmi_remote_service"/>
        </service>
        <activity android:name=".MinimalHomeActivity"
            android:label="SatNova TV Home"
            android:banner="@drawable/satnova_tv_banner"
            android:exported="true" android:screenOrientation="landscape">
            <!-- Allow relaunch from LifeMax apps before selecting default HOME. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
