<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:name="android.software.leanback"
        android:required="true" tools:node="replace"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <application tools:replace="android:label" android:label="SatNova TV Home"
        android:banner="@drawable/satnova_tv_banner">
        <!-- Expose HOME, LEANBACK_LAUNCHER and a normal apps-list shortcut. -->
        <activity android:name=".MobilePreviewActivity" tools:node="remove"/>
        <service android:name=".Zen4PersistentService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="connectedDevice"/>
        <!-- Standard TV launcher deliberately does not request Accessibility.
             HDMI key forwarding is available only in the separately built
             TV Bridge edition, with explicit user consent. -->
        <activity android:name=".MinimalHomeActivity"
            android:label="SatNova TV Home"
            android:banner="@drawable/satnova_tv_banner"
            android:exported="true" android:screenOrientation="landscape">
            <!-- Allow relaunch from LifeMax apps before selecting default HOME. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
