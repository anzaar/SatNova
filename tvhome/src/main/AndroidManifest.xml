<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Discover Zen 4 Wi-Fi broadcasts exactly as the working SatNova phone app. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.HOME"/>
        </intent>
    </queries>
    <application android:label="AltaPlay Launcher · Zen Prototype" android:theme="@style/SatNovaLaunchTheme"
        android:icon="@drawable/satnova_home_icon" android:allowBackup="false" android:usesCleartextTraffic="false">
        <activity android:name=".MobilePreviewActivity" android:label="SatNova Home · Test"
            android:exported="true" android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity android:name=".MinimalHomeActivity" android:exported="true"
            android:screenOrientation="landscape">
            <!-- Android caps positive intent priority to zero for non-privileged
                 launchers. HOME must be selected by Android; a user-enabled
                 Accessibility fallback can handle stock Google TV HOME. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
